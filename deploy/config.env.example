# Copy this file to C:\campus-vehicle\config.env on the server.
# The deploy script loads it before starting the backend.
# Do not commit the real config.env.

SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# Optional overrides
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/campus_vehicle?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
# CAMPUS_JWT_SECRET=change-this-to-a-long-random-string
# CAMPUS_QR_SECRET=change-this-to-another-long-random-string
# CAMPUS_ADMIN_PASSWORD=change-this-admin-password
