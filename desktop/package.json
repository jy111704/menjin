{
  "name": "campus-vehicle-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "校园车辆出入登记管理系统 桌面客户端",
  "author": "Campus Vehicle",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.campus.vehicle.desktop",
    "productName": "CampusVehicle",
    "asar": true,
    "compression": "maximum",
    "files": [
      "electron/**/*",
      "app-dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "校园车辆出入登记管理系统-便携版-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "校园车辆出入登记管理系统",
      "artifactName": "校园车辆出入登记管理系统-安装版-${version}.exe"
    }
  }
}
